{
  "name": "hbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node dist/server/index.js",
    "prestart": "npm run build",
    "start": "node dist/server/index.js",
    "startup:install": "npm run build && node scripts/windows-startup.mjs install",
    "startup:uninstall": "node scripts/windows-startup.mjs uninstall",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@melloware/coloris": "0.25.0",
    "saxes": "^6.0.0"
  }
}
