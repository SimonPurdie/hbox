{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist/public/assets",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "sourceMap": true
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
